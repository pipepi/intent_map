{
  "name": "intent-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-editor-dev.mjs",
    "build": "node scripts/build-editor-static.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:pip": "node --test tests/pip-format.test.mjs && node scripts/run-cargo.mjs test --manifest-path pip-seed/runtime/Cargo.toml && node scripts/run-cargo.mjs test --manifest-path pip-seed/cli/Cargo.toml && node scripts/run-cargo.mjs check --manifest-path pip-seed/tauri/Cargo.toml",
    "lint": "eslint .",
    "plugins:relation:build": "node scripts/build-relation-plugin-suites.mjs",
    "pip:build": "node scripts/build-editor-static.mjs && node scripts/build-editor-pip.mjs",
    "pip:verify": "node scripts/verify-pip.mjs",
    "pip:host": "node scripts/run-pip-host.mjs",
    "pip:desktop": "node scripts/run-pip-desktop.mjs",
    "pip:cli": "node scripts/build-seed-cli.mjs",
    "pip:seed": "node scripts/build-seed-desktop.mjs",
    "pip:loader": "node scripts/build-loader-pip.mjs",
    "pip:system": "node scripts/build-seed-source-pip.mjs && node scripts/build-loader-pip.mjs && node scripts/build-editor-static.mjs && node scripts/build-editor-pip.mjs",
    "pip:dist": "node scripts/build-distribution.mjs",
    "pip:install-user": "node scripts/install-user-pip.mjs",
    "pip:promote-system": "node scripts/promote-system-pip.mjs",
    "pip:workspace:split": "node scripts/split-pip-workspace.mjs",
    "pip:workspace:bundle": "node scripts/bundle-pip-workspace.mjs",
    "pip:workspace:unbundle": "node scripts/unbundle-pip-workspace.mjs",
    "pip:self:audit": "node scripts/audit-system-sources.mjs",
    "pip:self:extract": "node scripts/extract-system-sources.mjs",
    "pip:self:seal": "node scripts/seal-self-hosting-source.mjs",
    "pip:self:build": "node scripts/build-self-hosted-candidates.mjs"
  },
  "dependencies": {
    "es-module-lexer": "2.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "type": "module"
}
